# Copie este arquivo para .env (copy .env.example .env) e ajuste se precisar.
# O .env NUNCA deve ser commitado.

# Conexao com o PostgreSQL do docker-compose.yml (usuario, senha e banco: meubolso)
DATABASE_URL=postgresql+psycopg://meubolso:meubolso@localhost:5432/meubolso

# Chave usada para assinar os tokens JWT. Troque por um texto longo e aleatorio.
SECRET_KEY=troque-esta-chave
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
